# Production Dockerfile - Builds from git for consistency
ARG FRAPPE_VERSION=v15.42.3
FROM frappe/erpnext:${FRAPPE_VERSION}

ARG GIT_BRANCH=main
ARG GIT_COMMIT=unknown
ARG REPO_URL=https://github.com/genkiddoacademy/lms-genkiddo.git

USER root
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

WORKDIR /home/frappe/frappe-bench
USER frappe

# Clone from git (ensures prod uses committed code)
RUN cd apps && \
    rm -rf lms && \
    git clone --depth 1 --branch ${GIT_BRANCH} ${REPO_URL} lms && \
    cd lms && \
    git checkout ${GIT_COMMIT} && \
    echo "BRANCH=${GIT_BRANCH}" > .version && \
    echo "COMMIT=${GIT_COMMIT}" >> .version && \
    echo "BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .version && \
    pip install -e .

# Install frontend
RUN cd apps/lms/frontend && \
    yarn install && \
    yarn build

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
    CMD curl -f http://localhost:8000/api/method/ping || exit 1

LABEL git.commit="${GIT_COMMIT}" \
      git.branch="${GIT_BRANCH}" \
      build.date="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

EXPOSE 8000
CMD ["bench", "start"]
